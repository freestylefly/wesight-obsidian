{
  "name": "wesight-obsidian",
  "version": "0.9.4",
  "description": "WeSight Obsidian plugin for local agent runtimes.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "npm test && npm run lint && npm run build && npm run verify:release",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "wesight",
    "claude-code",
    "codex",
    "opencode"
  ],
  "author": "WeSight",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
