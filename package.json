    "eslint": "^9.39.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
